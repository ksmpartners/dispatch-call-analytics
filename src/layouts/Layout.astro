---
import '../styles/global.css';

interface Props { title: string; description: string; imageAlt?: string }
const { title, description, imageAlt = 'Dispatch Call Analytics: find any control-room call by what was said' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}/${p}`;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(asset('og-image.png'), Astro.site);
const siteName = 'Dispatch Call Analytics';

// Structured data so search engines understand the page as a software product from KSM.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.ksmpartners.com/#organization',
      name: 'KSM Technology Partners',
      url: 'https://www.ksmpartners.com/',
    },
    {
      '@type': 'SoftwareApplication',
      name: siteName,
      url: pageUrl.href,
      description,
      image: ogImage.href,
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'Call recording transcription and search',
      operatingSystem: 'Web',
      publisher: { '@id': 'https://www.ksmpartners.com/#organization' },
      audience: {
        '@type': 'BusinessAudience',
        audienceType:
          'Balancing Authorities, Reliability Coordinators, Transmission Operators, Generator Operators, Distribution Providers, ISOs and RTOs',
      },
    },
    {
      '@type': 'WebPage',
      name: title,
      url: pageUrl.href,
      description,
      inLanguage: 'en',
      publisher: { '@id': 'https://www.ksmpartners.com/#organization' },
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#070B16" />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href={asset('sitemap.xml')} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen overflow-x-hidden font-sans">
    <slot />
  </body>
</html>
