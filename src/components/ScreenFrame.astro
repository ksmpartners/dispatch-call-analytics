---
// A product screenshot in a dark app-window frame.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  title?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { src, alt, title, eager = false, sizes = '(min-width: 1024px) 50vw, 100vw', class: cls = '' } = Astro.props;
---
<figure class={`overflow-hidden rounded-xl border border-slate-700/70 bg-ink-850 shadow-2xl shadow-black/60 ring-1 ring-white/5 ${cls}`}>
  <div class="flex items-center gap-2 border-b border-slate-800 bg-ink-900 px-4 py-2.5">
    <span class="size-2.5 rounded-full bg-slate-600"></span>
    <span class="size-2.5 rounded-full bg-slate-600"></span>
    <span class="size-2.5 rounded-full bg-slate-600"></span>
    {title && <span class="ml-3 truncate text-xs text-slate-400">{title}</span>}
  </div>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1400, Math.min(src.width, 2000)]}
    sizes={sizes}
    format="webp"
    quality={88}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class="block h-auto w-full"
  />
</figure>
